integrator               = md
dt                       = 0.002
nsteps                   = 1000
nstlist                  = 10
cutoff-scheme            = Verlet
rlist                    = 0.8
coulombtype              = Cut-off
rcoulomb                 = 0.8
vdwtype                  = Cut-off
rvdw                     = 0.8
tcoupl                   = v-rescale
tc-grps                  = System
tau_t                    = 0.1
ref_t                    = 300
constraints              = h-bonds
pbc                      = xyz
gen_vel                  = yes
gen_temp                 = 300
gen_seed                 = 29
nstxout-compressed       = 100
nstenergy                = 100
nstlog                   = 100
