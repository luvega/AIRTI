manifest {
    name = 'AIRTI human-proteome reverse target fishing'
    version = '0.1.0'
    nextflowVersion = '>=24.10.0'
}

params {
    queries = null
    outdir = 'results/airti-target-fishing'
    mock_tools = false
    target_manifest = '/data/airti/reference/human_canonical_targets.jsonl'
    production_image = 'airti-tf:0.1.0-gpu'
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'

    withLabel: cpu_small {
        cpus = 2
        memory = '4 GB'
        time = '1h'
    }
    withLabel: cpu_screen {
        cpus = 8
        memory = '16 GB'
        time = '12h'
    }
    withLabel: gpu_boltz {
        cpus = 8
        memory = '48 GB'
        time = '24h'
        accelerator = 1
        containerOptions = '--gpus all'
    }
    withLabel: gpu_md {
        cpus = 12
        memory = '64 GB'
        time = '168h'
        accelerator = 1
        containerOptions = '--gpus all'
    }
    withName: TARGET_LIBRARY {
        container = params.production_image
    }
    withName: LIGAND_PREP {
        container = params.production_image
    }
    withName: SCREEN {
        container = params.production_image
    }
    withName: REFINE {
        container = params.production_image
    }
    withName: MD {
        container = params.production_image
    }
    withName: REPORT {
        container = params.production_image
    }
}

profiles {
    test {
        params.mock_tools = true
        process.executor = 'local'
        docker.enabled = false
    }
    local {
        process.executor = 'local'
        docker.enabled = true
    }
    production {
        process.executor = 'local'
        docker.enabled = true
        process.errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
        process.maxRetries = 1
    }
    hpc {
        process.executor = 'slurm'
        singularity.enabled = true
    }
}

timeline.enabled = true
report.enabled = true
trace.enabled = true
dag.enabled = true
